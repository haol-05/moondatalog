% 示例 3：聚合（aggregation）
% 运行：moon run cmd/main -- examples/aggregation.dl

% 员工与部门
employee(alice, eng).
employee(bob, eng).
employee(carol, sales).
employee(dave, sales).
employee(eve, sales).

% 每个部门的员工数
dept_size(D, N) :- employee(X, D), N = count : { X }.

% 最大的部门人数
max_dept(N) :- dept_size(_, S), N = max : { S }.

?- dept_size(D, N).
?- max_dept(N).

% 数值聚合
score(1, 10).
score(2, 20).
score(3, 30).
score(4, 40).

total(T) :- score(_, S), T = sum : { S }.
minimum(M) :- score(_, S), M = min : { S }.
maximum(M) :- score(_, S), M = max : { S }.
average(A) :- score(_, S), A = avg : { S }.

?- total(T).
?- minimum(M).
?- maximum(M).
?- average(A).
